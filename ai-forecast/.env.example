# Laravel reads this project's ../.env for MongoDB; no credentials are copied into model artifacts.
# Optional overrides: MONGODB_URI and MONGODB_DATABASE.
FORECAST_PORT=8001
FORECAST_ENV=local
# Outside local, set a random FORECAST_API_KEY here AND in Laravel's .env.
# Laravel accepts FORECAST_API_URL (default http://127.0.0.1:8001) and FORECAST_API_TIMEOUT (default 15 seconds).
